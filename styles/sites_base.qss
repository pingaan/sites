/* ---------------------------------------------------------
   Sites — shared modern desktop design
   --------------------------------------------------------- */

QMainWindow,
QDialog {
    background-color: #f4f6f8;
    color: #202124;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d9dee5;
    padding: 3px;
}

QMenuBar::item {
    background: transparent;
    border-radius: 5px;
    padding: 5px 9px;
}

QMenuBar::item:selected {
    background-color: #e9eef5;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cfd5dd;
    border-radius: 7px;
    padding: 5px;
}

QMenu::item {
    border-radius: 4px;
    padding: 7px 28px 7px 10px;
}

QMenu::item:selected {
    background-color: #e5efff;
    color: #174ea6;
}

QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #d9dee5;
    spacing: 6px;
    padding: 6px;
}

QToolBar::separator {
    background-color: #d9dee5;
    width: 1px;
    margin: 5px 7px;
}

QToolButton,
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd2dc;
    border-radius: 6px;
    padding: 6px 10px;
}

QToolButton:hover,
QPushButton:hover {
    background-color: #edf3fb;
    border-color: #8ba9cf;
}

QToolButton:pressed,
QPushButton:pressed {
    background-color: #dce9f8;
}

QToolButton:disabled,
QPushButton:disabled {
    background-color: #f3f4f6;
    border-color: #e1e4e8;
    color: #9aa0a6;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c7ced8;
    border-radius: 6px;
    min-height: 26px;
    padding: 3px 8px;
    selection-background-color: #3478d4;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid #3478d4;
    padding: 2px 7px;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c7ced8;
    selection-background-color: #e5efff;
    selection-color: #174ea6;
    padding: 3px;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 7px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    color: #5f6368;
    min-width: 80px;
    padding: 8px 14px;
}

QTabBar::tab:hover {
    background-color: #edf1f6;
    color: #202124;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #174ea6;
    border-bottom: 3px solid #3478d4;
}

QDockWidget {
    color: #202124;
}

QDockWidget::title {
    background-color: #eef1f5;
    border-bottom: 1px solid #d4dae2;
    padding: 7px 9px;
    text-align: left;
}

QTreeView,
QTreeWidget,
QTableView,
QTableWidget,
QTextBrowser,
QPlainTextEdit,
QTextEdit {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #d5dbe3;
    border-radius: 5px;
    color: #202124;
    selection-background-color: #dceaff;
    selection-color: #174ea6;
}

QTreeView::item,
QTreeWidget::item {
    min-height: 24px;
    padding: 2px;
}

QTreeView::item:hover,
QTreeWidget::item:hover {
    background-color: #edf3fb;
}

QHeaderView::section {
    background-color: #eef1f5;
    border: none;
    border-right: 1px solid #d5dbe3;
    border-bottom: 1px solid #d5dbe3;
    padding: 6px;
    font-weight: 600;
}

QProgressBar {
    background-color: #e3e7ec;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3478d4;
    border-radius: 5px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d9dee5;
    color: #5f6368;
}

QSplitter::handle {
    background-color: #d8dde5;
}

QSplitter::handle:hover {
    background-color: #aeb8c5;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #b9c0c9;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #929ba7;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #b9c0c9;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #929ba7;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}